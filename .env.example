# Sokhan configuration
# Copy this file to .env and adjust the values.
# Every variable below has a working default for local development.

# --- Core ---
# PostgreSQL connection used by the API, the worker and Alembic.
DATABASE_URL=postgresql+psycopg://sokhan:sokhan@localhost:5432/sokhan

# Redis is used as the Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Set to "false" to run transcription inline (no Redis/worker required).
# Handy for development and tiny deployments; real deployments should use the worker.
CELERY_ENABLED=true

# Directory where uploaded audio files and generated exports are stored.
DATA_DIR=./data

# --- Whisper ---
# Model size: tiny / base / small / medium / large-v3
# "small" is a good trade-off for Persian on CPU.
WHISPER_MODEL_SIZE=small

# cpu or cuda
WHISPER_DEVICE=cpu

# int8 is recommended on CPU, float16 on GPU.
WHISPER_COMPUTE_TYPE=int8

# Decoder beam width. 5 matches the benchmark and Gradio demo config.
WHISPER_BEAM_SIZE=5

# Optional domain lexicon passed to the decoder as an initial prompt, so
# project names and technical terms survive transcription (v1.4 roadmap).
WHISPER_INITIAL_PROMPT=

# Rule-based Persian punctuation restoration applied to every finished
# transcript (question marks, commas, sentence periods, spacing). Set to
# "false" for the raw Whisper word stream.
PUNCTUATION_ENABLED=true

# Segments whose model confidence (exp(avg_logprob), 0..1) falls below this
# are flagged with a review marker in the SRT/VTT/DOCX exports and in the
# dashboard timeline. Set to 0 to disable flagging.
LOW_CONFIDENCE_THRESHOLD=0.5

# --- Speaker diarization (optional) ---
# stub    = no speaker labels (default, exactly the v1 behaviour)
# energy  = dependency-free heuristic: voiced regions split into at most two
#           acoustic clusters (numpy only; labels are similarity, not identity)
# pyannote= real neural diarization; needs `pip install "backend[diarize]"`,
#           a Hugging Face token for the gated weights, and enough RAM for torch.
# If the selected engine cannot start, jobs still run — without speaker labels.
DIARIZATION_ENGINE=stub
PYANNOTE_HF_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# --- Quota ---
# Free transcription minutes per user per month. Usage is tracked per user in the database.
FREE_MINUTES_PER_USER_PER_MONTH=30

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=200

# --- LLM summaries (optional) ---
# Any OpenAI-compatible chat-completions endpoint works.
# Set SUMMARY_ENABLED=true and provide a key to turn summaries on.
# Without a key the rest of the product keeps working; summaries are simply unavailable.
SUMMARY_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=

# URL the bot puts in messages so users can open their archive in the browser.
WEB_BASE_URL=http://localhost:3000

# Backend address the bot process talks to.
API_BASE_URL=http://localhost:8000

# --- Web ---
# Browser-facing API base URL used by the Next.js app.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Deployment (deploy/docker-compose.yml) ---
# Required: the compose file refuses to start without a real password.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Comma-separated public origins allowed to call the API (no wildcard).
# Example: SOKHAN_CORS_ORIGINS=https://sokhan.example.com
SOKHAN_CORS_ORIGINS=
