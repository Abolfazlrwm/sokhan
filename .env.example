# Sokhan configuration
# Copy this file to .env and adjust the values.
# Every variable below has a working default for local development.

# --- Core ---
# PostgreSQL connection used by the API, the worker and Alembic.
DATABASE_URL=postgresql+psycopg://sokhan:sokhan@localhost:5432/sokhan

# Redis is used as the Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Set to "false" to run transcription inline (no Redis/worker required).
# Handy for development and tiny deployments; real deployments should use the worker.
CELERY_ENABLED=true

# Directory where uploaded audio files and generated exports are stored.
DATA_DIR=./data

# --- Whisper ---
# Model size: tiny / base / small / medium / large-v3
# "small" is a good trade-off for Persian on CPU.
WHISPER_MODEL_SIZE=small

# cpu or cuda
WHISPER_DEVICE=cpu

# int8 is recommended on CPU, float16 on GPU.
WHISPER_COMPUTE_TYPE=int8

# --- Quota ---
# Free transcription minutes per user per month. Usage is tracked per user in the database.
FREE_MINUTES_PER_USER_PER_MONTH=30

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=200

# --- LLM summaries (optional) ---
# Any OpenAI-compatible chat-completions endpoint works.
# Set SUMMARY_ENABLED=true and provide a key to turn summaries on.
# Without a key the rest of the product keeps working; summaries are simply unavailable.
SUMMARY_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=

# URL the bot puts in messages so users can open their archive in the browser.
WEB_BASE_URL=http://localhost:3000

# Backend address the bot process talks to.
API_BASE_URL=http://localhost:8000

# --- Web ---
# Browser-facing API base URL used by the Next.js app.
NEXT_PUBLIC_API_BASE=http://localhost:8000
